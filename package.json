{
  "name": "deciball-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Deciball - Music collaboration platform monorepo",
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "web:dev": "turbo run dev --filter=web",
    "ws:dev": "turbo run dev --filter=ws",
    "web:build": "turbo run build --filter=web",
    "ws:build": "turbo run build --filter=ws"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.9.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "overrides": {
      "@prisma/client": "5.19.1",
      "prisma": "5.19.1"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@react-three/fiber>react-dom": "19",
        "next-auth>next": "16",
        "@react-three/fiber>react": "19"
      }
    }
  }
}
