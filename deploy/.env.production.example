# === Docker Compose ===
POSTGRES_USER=deciball
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=deciball
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# === apps/web/.env.production ===
# Copy this section to apps/web/.env.production

DATABASE_URL="postgresql://deciball:CHANGE_ME_STRONG_PASSWORD@deciball-postgres:5432/deciball"
DIRECT_URL="postgresql://deciball:CHANGE_ME_STRONG_PASSWORD@deciball-postgres:5432/deciball"
REDIS_URL="redis://:CHANGE_ME_REDIS_PASSWORD@deciball-redis:6379"
REDIS_HOST="deciball-redis"
REDIS_PORT="6379"
REDIS_PASSWORD="CHANGE_ME_REDIS_PASSWORD"

NEXTAUTH_SECRET="GENERATE_WITH_openssl_rand_base64_32"
NEXTAUTH_URL="https://deciball.zeusnotfound.codes"
NEXT_PUBLIC_WSS_URL="wss://deciball.zeusnotfound.codes/ws"

GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

JWT_SECRET="GENERATE_WITH_openssl_rand_base64_32"

UPLOADTHING_SECRET="your-uploadthing-secret"
UPLOADTHING_APP_ID="your-uploadthing-app-id"

SPOTIFY_CLIENT_ID="your-spotify-client-id"
SPOTIFY_CLIENT_SECRET="your-spotify-client-secret"

# === apps/ws/.env.production ===
# Copy this section to apps/ws/.env.production

